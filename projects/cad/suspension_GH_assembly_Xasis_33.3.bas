Attribute VB_Name = "SUSP_2027_build"
' FSAE 2027 suspension -- SolidWorks assembly: one part per component, mated to move
' Generated by scripts/export_suspension_assembly.py from FSAE_2027.vdproj.json
' Frame: forward -Y, left -X, up -Z; ISO origin at CAD (0, -120.4, 75) mm. API units are metres.
' Placeholder diameters on the project's points: a modelling aid, not a detailed
' or structural design. Do not hand-edit: change the project and regenerate.
'
' Tools > Macro > New (save a blank .swp), then in the VBA editor
' File > Import File... > this .bas. Open the module SUSP_2027_build, click inside
' Sub main and press F5 (the .swp's own module has an empty main). It asks for a folder,
' writes 47 files there (42 parts, 4 corner assemblies and the top one)
' and a log, SUSP_2027_log.txt. Re-running replaces those files: close the
' assemblies that use them first.

Option Explicit

Const ASM_NAME As String = "SUSP_2027"
Const N_BODIES As Long = 149
Const N_REFS As Long = 136
Const N_MATES As Long = 68

