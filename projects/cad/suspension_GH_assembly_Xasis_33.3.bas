End Sub

Private Sub WriteLog()
    Dim fnum As Integer
    On Error Resume Next
    fnum = FreeFile
    Open gDir & ASM_NAME & "_log.txt" For Output As #fnum
    Print #fnum, gLog
    Close #fnum
End Sub

