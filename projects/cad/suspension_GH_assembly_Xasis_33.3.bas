Dim gRefAxis(1 To 64) As Boolean
Dim gRefX(1 To 64) As Double
Dim gRefY(1 To 64) As Double
Dim gRefZ(1 To 64) As Double
Dim gSegA(1 To 64) As Object
Dim gSegB(1 To 64) As Object
Dim gSegNameA(1 To 64) As String
Dim gSegNameB(1 To 64) As String

Private Sub LogLine(ByVal s As String)
