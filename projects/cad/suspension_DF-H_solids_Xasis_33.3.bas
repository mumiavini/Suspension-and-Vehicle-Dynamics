' FSAE 2027 suspension -- primitive solids (cylinders) and centreline skeleton
' Generated by scripts/export_suspension_solids.py from FSAE_2027.vdproj.json
' Frame: forward -Y, left -X, up -Z; ISO origin at CAD (0, -120.4, 75) mm. API units are metres.
' Placeholder diameters on the project's points: a modelling aid, not a detailed
' or structural design. Do not hand-edit: change the project and regenerate.
'
' Tools > Macro > New (save a blank .swp), then in the VBA editor
' File > Import File... > this .bas, then run main (F5).

Option Explicit

Dim swApp As Object
Dim swModel As Object
Dim swModeler As Object
Dim gCentred As Boolean
Dim gMade As Long
Dim gFailed As Long
Dim gFailList As String

Sub main()
    Set swApp = Application.SldWorks
    Set swModel = swApp.ActiveDoc
    Dim useActive As Boolean
    useActive = False
    If Not swModel Is Nothing Then
        If swModel.GetType = 1 Then
            If InStr(1, LCase(swModel.GetTitle), "susp", vbTextCompare) > 0 Then useActive = True
        End If
    End If
    If Not useActive Then
        ' a new, empty part: never write into the chassis or another part
        Dim tmpl As String
        tmpl = swApp.GetUserPreferenceStringValue(8)
        Set swModel = swApp.NewDocument(tmpl, 0, 0, 0)
        If swModel Is Nothing Then
            MsgBox "Could not create a new part (default part template)."
            Exit Sub
        End If
    End If
    Set swModeler = swApp.GetModeler
    DeletePrevious
    Calibrate
    swModel.FeatureManager.EnableFeatureTree = False
    gMade = 0: gFailed = 0: gFailList = ""
    Build_bracket
    Build_coilover
    Build_rocker
    Build_rod
    Build_spring
    Build_steering
    Build_upright
    Build_wheel
    Build_wishbone
    swModel.FeatureManager.EnableFeatureTree = True
    BuildSketches
    swModel.EditRebuild3
    swModel.ViewZoomtofit2
    Dim msg As String
    msg = "Suspension solids: " & gMade & " made, " & gFailed & " failed."
    If gFailed > 0 Then msg = msg & vbCrLf & gFailList
    MsgBox msg
End Sub

' CreateBodyFromCyl takes a point, an axis, a radius and a length. Whether the point
' is the base or the middle of the cylinder is measured here on a probe body.
Private Sub Calibrate()
    Dim p(7) As Double
    p(0) = 0: p(1) = 0: p(2) = 0: p(3) = 0: p(4) = 0: p(5) = 1
    p(6) = 0.01: p(7) = 0.1
    Dim v As Variant
    v = p
    Dim b As Object
    Set b = swModeler.CreateBodyFromCyl((v))
    gCentred = False
    If Not b Is Nothing Then
        Dim bx As Variant
        bx = b.GetBodyBox
        If Abs(bx(2) + 0.05) < 0.005 Then gCentred = True
    End If
End Sub

Private Sub DeletePrevious()
    Dim f As Object
    Dim n As Long
    swModel.ClearSelection2 True
    Set f = swModel.FirstFeature
    Do While Not f Is Nothing
        If Left(f.Name, 5) = "SUSP_" Then
            If f.Select2(True, 0) Then n = n + 1
        End If
        Set f = f.GetNextFeature
    Loop
    ' delete the selection with its children, without a confirmation dialog
    If n > 0 Then
        If Not swModel.Extension.DeleteSelection2(3) Then swModel.EditDelete
    End If
    swModel.ClearSelection2 True
End Sub

Private Function MakeCylBody(ByVal x1 As Double, ByVal y1 As Double, _
                             ByVal z1 As Double, ByVal x2 As Double, _
                             ByVal y2 As Double, ByVal z2 As Double, _
                             ByVal r As Double) As Object
    Dim dx As Double, dy As Double, dz As Double, L As Double
    dx = x2 - x1: dy = y2 - y1: dz = z2 - z1
    L = Sqr(dx * dx + dy * dy + dz * dz)
    If L < 0.000001 Or r <= 0 Then Exit Function
    Dim p(7) As Double
    If gCentred Then
        p(0) = (x1 + x2) / 2: p(1) = (y1 + y2) / 2: p(2) = (z1 + z2) / 2
    Else
        p(0) = x1: p(1) = y1: p(2) = z1
    End If
    p(3) = dx / L: p(4) = dy / L: p(5) = dz / L: p(6) = r: p(7) = L
    Dim v As Variant
    v = p
    Set MakeCylBody = swModeler.CreateBodyFromCyl((v))
End Function

Private Sub Cyl(ByVal nm As String, ByVal x1 As Double, ByVal y1 As Double, _
                ByVal z1 As Double, ByVal x2 As Double, ByVal y2 As Double, _
                ByVal z2 As Double, ByVal od As Double, ByVal idia As Double, _
                ByVal cr As Double, ByVal cg As Double, ByVal cb As Double)
    Dim b As Object, inner As Object, f As Object
    Set b = MakeCylBody(x1, y1, z1, x2, y2, z2, od / 2)
    If b Is Nothing Then GoTo failed
    If idia > 0 Then
        ' a tube: cut a longer inner cylinder; keep the solid one if the cut fails
        Dim ex As Double, ey As Double, ez As Double, L As Double
        L = Sqr((x2 - x1) ^ 2 + (y2 - y1) ^ 2 + (z2 - z1) ^ 2)
        ex = (x2 - x1) / L * 0.001: ey = (y2 - y1) / L * 0.001
        ez = (z2 - z1) / L * 0.001
        Set inner = MakeCylBody(x1 - ex, y1 - ey, z1 - ez, x2 + ex, y2 + ey, z2 + ez, idia / 2)
        If Not inner Is Nothing Then
            Dim res As Variant, opErr As Long
            On Error Resume Next
            res = b.Operations2(15902, inner, opErr)
            If opErr = 0 And Not IsEmpty(res) Then
                If UBound(res) >= 0 Then Set b = res(0)
            End If
            On Error GoTo 0
        End If
    End If
    Set f = swModel.CreateFeatureFromBody3(b, False, 0)
    If f Is Nothing Then GoTo failed
    f.Name = nm
    Dim c(8) As Double
    c(0) = cr: c(1) = cg: c(2) = cb: c(3) = 0.5: c(4) = 0.7: c(5) = 0.3
    c(6) = 0.3: c(7) = 0: c(8) = 0
    Dim cv As Variant
    cv = c
    On Error Resume Next
    f.SetMaterialPropertyValues2 cv, 1, Nothing
    On Error GoTo 0
    gMade = gMade + 1
    Exit Sub
failed:
    gFailed = gFailed + 1
    If gFailed <= 20 Then gFailList = gFailList & nm & vbCrLf
End Sub

