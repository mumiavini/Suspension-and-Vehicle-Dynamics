  "targets": [
    {
      "name": "Front roll centre height",
      "value": 35.0,
      "unit": "mm",
      "tolerance": 10.0,
      "event": "all",
      "rationale": "Low RC keeps most lateral transfer elastic (tunable) and jacking small; 25-45 mm band.",
      "reference": "Milliken RCVD Ch.17; Optimum G",
      "source": "design_intent"
    },
    {
      "name": "Rear roll centre height",
      "value": 55.0,
      "unit": "mm",
      "tolerance": 10.0,
      "event": "all",
      "rationale": "Rear above front tilts the roll axis nose-down: directional stability, more geometric transfer at the rear.",
      "reference": "Milliken RCVD Ch.17",
      "source": "design_intent"
    },
    {
      "name": "Front FVSA length",
      "value": 1500.0,
      "unit": "mm",
      "tolerance": 200.0,
      "event": "all",
      "rationale": "Camber gain ~57.3/FVSA deg/mm recovers 60-80 % of roll over the first 25 mm of travel without a nervous RC.",
      "reference": "Milliken RCVD Ch.17",
      "source": "design_intent"
    },
    {
      "name": "Roll gradient",
      "value": 1.0,
      "unit": "deg/g",
      "tolerance": 0.3,
      "event": "all",
      "rationale": "0.8-1.5 deg/g: enough roll to use the camber gain, little enough to keep camber negative on the outer tyre.",
      "reference": "Milliken RCVD Ch.16; FSAE design reports",
      "source": "design_intent"
    },
    {
      "name": "Static camber",
      "value": -1.5,
      "unit": "deg",
      "tolerance": 0.5,
      "event": "all",
      "rationale": "Offsets the +roll camber the outer tyre sees at 1.5 g.",
      "reference": "Concept closure, random_calcs.ipynb",
      "source": "design_intent"
    },
    {
      "name": "Front anti-dive",
      "value": 7.5,
      "unit": "%",
      "tolerance": 2.5,
      "event": "autocross",
      "rationale": "Mid-band of the 5-10 % the team asked for; limits pitch under braking without killing brake feel.",
      "reference": "sla_geometry.FRONT_2027",
      "source": "design_intent"
    },
    {
      "name": "Ackermann at 10 deg outer",
      "value": 100.0,
      "unit": "%",
      "tolerance": 40.0,
      "event": "autocross",
      "rationale": "Tight FSAE hairpins favour near-true Ackermann at low speed.",
      "reference": "steering_geometry.STEERING_2027",
      "source": "design_intent"
    },
    {
      "name": "Chassis torsion / roll stiffness",
      "value": 4.0,
      "unit": "x",
      "tolerance": 1.0,
      "event": "all",
      "rationale": "3-5x keeps the front/rear roll-stiffness split meaningful.",
      "reference": "SAE 2002-01-3300; Optimum G seminars",
      "source": "design_intent"
    }
  ],
