  "design_log": [
    {
      "date": "2026-10-13",
      "stage": "geometry",
      "title": "Chassis CAD pick-ups adopted as the master",
      "decision": "Inboard UCA/LCA pick-ups (16) taken from the chassis CAD 'Xasis 33.3' (PSD/PST frame nodes) via scripts/import_chassis_pickups.py; project switched to hardpoint mode.",
      "rationale": "The chassis team moved the pick-ups within the rules suspension gave them; front-view geometry is nearly unchanged (camber gain change < 1e-4 deg/mm, RC height -1.8 / -1.2 mm). Consequences recorded: front RC migration -0.200 -> -0.278 mm/mm, bump steer ~0.002 deg/mm both axles (tie rods sized for the old arms), rear anti-squat 0 -> 15 %, front UCA/LCA ratio 0.82 -> 0.77, rear wishbone sweep e/a above 2.",
      "alternatives": "Keep the synthesis pick-ups and ask the chassis to move its nodes 30-58 mm.",
      "author": "Vinicius Trento"
    }
  ],
